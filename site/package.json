{
  "name": "syntonia-site-source",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.ssr.config.js && node scripts/ssg.mjs && node scripts/check-meta.mjs && node scripts/check-dist.mjs",
    "publish": "node scripts/publish.mjs",
    "deploy": "npm run build && node scripts/publish.mjs",
    "preview": "vite preview",
    "golden": "node scripts/verify-golden.mjs",
    "gate": "node scripts/gates/run.mjs",
    "gate:golden": "node scripts/gates/run.mjs --only golden",
    "gate:contract": "node scripts/gates/run.mjs --only contract",
    "probe": "node scripts/gates/probe.mjs",
    "gate:changed": "node scripts/gates/run.mjs --changed --fast --only golden,contract",
    "gate:a11y": "node scripts/gates/a11y.mjs"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/hurricane": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "fflate": "^0.8.3",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
